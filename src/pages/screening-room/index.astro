---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Screening Room — The Green Screen"
  description="Recorded readings and conversations between climate fiction writers and retrofit engineers."
>
  <div class="max-w-7xl mx-auto px-6 py-10">
    <!-- Header -->
    <div class="border-b-2 border-ink pb-6 mb-8">
      <p class="font-mono text-[9px] uppercase tracking-widest text-gold mb-1">Part 03 — Dialogues & Readings</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink">The Screening Room</h1>
      <p class="font-display italic text-lg text-ink-60 mt-2 max-w-2xl">
        A series of recorded readings and conversations that turn the archive into an active civic community. Where literature encounters engineering.
      </p>
    </div>

    <!-- Empty State / Skeleton Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {[1, 2].map((_n) => (
        <div class="border border-ink-12 p-6 sm:p-8 space-y-5 bg-canvas">
          <div class="flex justify-between items-center">
            <div class="skeleton h-3 w-20 rounded"></div>
            <div class="skeleton h-3 w-16 rounded"></div>
          </div>
          <div class="space-y-2">
            <div class="skeleton h-7 w-full rounded"></div>
            <div class="skeleton h-7 w-2/3 rounded"></div>
          </div>
          <div class="border-y border-ink-12 py-3 space-y-2">
            <div class="skeleton h-3 w-28 rounded"></div>
            <div class="skeleton h-3 w-44 rounded"></div>
          </div>
          <div class="border border-ink-12 p-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded-full skeleton"></div>
              <div class="space-y-1">
                <div class="skeleton h-3 w-24 rounded"></div>
                <div class="skeleton h-2.5 w-16 rounded"></div>
              </div>
            </div>
            <div class="skeleton h-3 w-12 rounded"></div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 py-8 text-center border-t border-ink-12 font-ui text-[12px] text-ink-60 italic">
      The inaugural Screening Room sessions are in production and will be published alongside Issue 1.
    </div>
  </div>
</Layout>
