---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="The Atlas — The Green Screen"
  description="Database of real buildings and retrofit engineering interventions cross-referenced with literary stories."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center">
    <!-- Archival Blueprint Stamp -->
    <div class="inline-block border border-forest/40 bg-forest/5 px-4 py-1.5 font-mono text-xs uppercase tracking-widest text-forest mb-6">
      PART 02 // DATABASE COMPANION
    </div>

    <h1 class="font-display text-4xl sm:text-6xl text-forest font-semibold tracking-tight">
      The Atlas
    </h1>

    <p class="font-serif italic text-xl sm:text-2xl text-ink-light mt-4 max-w-2xl mx-auto leading-relaxed">
      A technical database of real buildings and retrofit interventions, cross-referenced with the stories.
    </p>

    <!-- Coming Soon Architectural Dossier Box -->
    <div class="mt-12 border-2 border-dashed border-blueprint bg-canvas-card p-8 sm:p-12 max-w-2xl mx-auto text-left space-y-6">
      <div class="flex items-center justify-between border-b border-blueprint pb-4 font-mono text-xs text-ink-muted">
        <span>STATUS: IN EDITORIAL INTAKE & VERIFICATION</span>
        <span class="text-terracotta font-semibold">COMING SOON</span>
      </div>

      <div class="space-y-4 font-serif text-ink-light text-base sm:text-lg leading-relaxed">
        <p>
          The Atlas is currently undergoing technical audit and certification with our environmental building engineers and architectural advisors.
        </p>
        <p>
          When launched, it will feature comprehensive blueprints, verified U-values, embodied carbon lifecycle calculations, and direct cross-references to the narratives in <a href="/archive" class="text-forest underline font-sans font-medium">The Archive</a>.
        </p>
      </div>

      <!-- Specimen Sneak Peek Grid -->
      <div class="border-t border-blueprint pt-6 space-y-3 font-mono text-xs">
        <div class="text-ink-muted uppercase text-[10px]">Under Documentation:</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-ink">
          <div class="border border-blueprint bg-canvas p-3">
            <span class="text-forest font-semibold block">Rio Cinema</span>
            <span class="text-ink-muted text-[11px]">Dalston · Hemp-Lime Internal Lining</span>
          </div>
          <div class="border border-blueprint bg-canvas p-3">
            <span class="text-forest font-semibold block">Woodberry Down School</span>
            <span class="text-ink-muted text-[11px]">Hackney · Rockwool Rainscreen Cladding</span>
          </div>
        </div>
      </div>

      <div class="pt-4 text-center">
        <a
          href="/archive"
          class="inline-block px-6 py-3 bg-forest text-canvas font-sans text-xs uppercase tracking-wider font-semibold hover:bg-forest-dark transition-colors"
        >
          Explore Stories in The Archive Instead →
        </a>
      </div>
    </div>
  </div>
</Layout>
