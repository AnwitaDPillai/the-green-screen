---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { isPubliclyPublished } from '../../lib/publication';
import { micromark } from 'micromark';

export async function getStaticPaths() {
  const allStories = await getCollection('archive');
  // CRITICAL: Generate routes ONLY for strictly published pieces
  const publishedStories = allStories.filter((story) => isPubliclyPublished(story));

  return publishedStories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

const { story } = Astro.props;
const { Content } = await story.render();

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(story.data.publishDate));

const technicalReportHtml = story.data.technicalReport 
  ? micromark(story.data.technicalReport) 
  : null;
---

<Layout
  title={`${story.data.title} — The Green Screen`}
  description={story.data.subtitle || `${story.data.genre} by ${story.data.author}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between border-b border-blueprint pb-3 mb-8 gap-3">
      <nav class="font-mono text-xs text-ink-muted flex items-center space-x-2">
        <a href="/archive" class="hover:text-forest transition-colors">THE ARCHIVE</a>
        <span>/</span>
        <span class="text-terracotta uppercase">{story.data.genre}</span>
        <span>/</span>
        <span class="text-ink truncate max-w-xs sm:max-w-md">{story.data.title}</span>
      </nav>

      <!-- Mobile Companion Switcher -->
      {technicalReportHtml && (
        <div class="lg:hidden flex items-center gap-2">
          <button
            id="mobile-view-story-btn"
            class="px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider bg-forest text-canvas border border-forest transition-colors"
          >
            Fiction
          </button>
          <button
            id="mobile-view-report-btn"
            class="px-3 py-1.5 font-mono text-xs font-semibold uppercase tracking-wider bg-canvas text-ink border border-blueprint hover:border-forest transition-colors"
          >
            Technical Brief
          </button>
        </div>
      )}
    </div>

    <!-- Layout Grid: Literary Article (Left) + Sticky Technical Companion Side Panel (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start relative">
      <!-- Article Center Column -->
      <article id="fiction-column" class="lg:col-span-7 xl:col-span-7 space-y-8">
        <!-- Title Header -->
        <header class="space-y-4 border-b border-blueprint pb-8">
          <div class="flex items-center space-x-3 font-mono text-xs text-ink-muted">
            <span class="px-2 py-0.5 bg-forest text-canvas text-[10px] font-semibold uppercase">
              ISSUE NO. {story.data.issueNumber}
            </span>
            <span>·</span>
            <span>{story.data.readingTimeMinutes} MINUTE READ</span>
            <span>·</span>
            <time datetime={story.data.publishDate.toISOString()}>{formattedDate}</time>
          </div>

          <h1 class="font-display text-4xl sm:text-5xl text-forest font-semibold leading-[1.1] tracking-tight">
            {story.data.title}
          </h1>

          {story.data.subtitle && (
            <p class="font-serif italic text-xl sm:text-2xl text-ink-light leading-relaxed">
              {story.data.subtitle}
            </p>
          )}

          <div class="pt-4 flex items-center justify-between font-sans text-xs sm:text-sm border-t border-blueprint/60">
            <div>
              <span class="text-ink-muted">By</span>{' '}
              <span class="font-semibold text-ink">{story.data.author}</span>
            </div>
            <!-- Citation Button / Modal Trigger -->
            <button
              onclick="document.getElementById('citation-dialog').showModal()"
              class="font-mono text-xs text-forest hover:text-forest-dark uppercase tracking-wider underline cursor-pointer"
            >
              [Cite this Piece]
            </button>
          </div>
        </header>

        <!-- Literary Text with Drop Cap -->
        <div class="prose prose-lg max-w-none text-ink font-serif drop-cap leading-relaxed">
          <Content />
        </div>

        <!-- Author Biography & Editorial Sign-off -->
        <footer class="mt-14 pt-8 border-t-2 border-forest space-y-6">
          <div class="bg-canvas-card border border-blueprint p-6 space-y-2">
            <span class="font-mono text-[10px] uppercase text-forest font-semibold tracking-wider block">
              CONTRIBUTOR DOSSIER
            </span>
            <h4 class="font-display text-lg text-ink font-semibold">{story.data.author}</h4>
            {story.data.authorBio && (
              <p class="font-serif italic text-sm text-ink-muted leading-relaxed">
                {story.data.authorBio}
              </p>
            )}
          </div>

          <!-- Sources & Fact-check certification -->
          {story.data.sources && story.data.sources.length > 0 && (
            <div class="border border-blueprint bg-canvas-paper p-5 font-mono text-xs space-y-2 text-ink-muted">
              <div class="text-[11px] font-semibold uppercase text-forest flex items-center space-x-2">
                <span>✓ FACT-CHECK & RETROFIT VERIFICATION SOURCES</span>
              </div>
              <ul class="list-disc list-inside space-y-1 text-[11px]">
                {story.data.sources.map((src) => (
                  <li class="break-all">
                    <a href={src} target="_blank" rel="noopener noreferrer" class="hover:text-forest underline">
                      {src}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </footer>
      </article>

      <!-- Sticky Technical Companion Side Panel (Right) -->
      <aside
        id="technical-panel"
        class="hidden lg:block lg:col-span-5 xl:col-span-5 lg:sticky lg:top-24 space-y-6 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2 custom-scrollbar"
      >
        <!-- Real Retrofit Metadata Header Card -->
        <div class="border border-blueprint bg-canvas-paper p-5 space-y-4 shadow-sm">
          <div class="border-b border-blueprint pb-3 flex justify-between items-center">
            <span class="font-mono text-xs font-semibold text-forest uppercase tracking-wider">
              REAL RETROFIT COMPANION
            </span>
            <span class="font-mono text-[10px] px-2 py-0.5 bg-terracotta/10 text-terracotta font-semibold uppercase">
              PARALLEL BRIEF
            </span>
          </div>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div>
              <span class="font-mono text-[10px] uppercase text-ink-muted tracking-wider block">Real Building</span>
              <h3 class="font-display text-sm text-ink font-semibold">{story.data.pairedBuildingName}</h3>
              <p class="font-sans text-[11px] text-ink-muted">{story.data.pairedBuildingLocation}</p>
            </div>

            <div>
              <span class="font-mono text-[10px] uppercase text-ink-muted tracking-wider block">Typology</span>
              <span class="font-sans text-xs font-medium text-forest uppercase">
                {story.data.buildingTypology}
              </span>
            </div>

            <div class="col-span-2 border-t border-blueprint pt-2">
              <span class="font-mono text-[10px] uppercase text-ink-muted tracking-wider block">Intervention</span>
              <p class="font-serif italic text-xs text-ink leading-snug">
                {story.data.pairedIntervention}
              </p>
            </div>

            {story.data.technicalAuthor && (
              <div class="col-span-2 border-t border-blueprint/60 pt-2 flex items-center justify-between font-mono text-[11px]">
                <span class="text-ink-muted uppercase text-[10px]">Technical Author:</span>
                <span class="font-semibold text-forest">{story.data.technicalAuthor}</span>
              </div>
            )}
          </div>
        </div>

        <!-- Full Technical Report Body -->
        {technicalReportHtml ? (
          <div class="border border-blueprint bg-canvas-paper p-6 space-y-4 shadow-sm">
            <div class="border-b border-blueprint pb-3 flex items-center justify-between">
              <div>
                <h2 class="font-mono text-xs font-bold text-forest uppercase tracking-wider">
                  TECHNICAL REPORT ON RETROFIT APPLICATION
                </h2>
                {story.data.technicalAuthor && (
                  <p class="font-sans text-[11px] text-ink-muted mt-0.5">
                    Authored by <span class="font-semibold text-ink">{story.data.technicalAuthor}</span>
                  </p>
                )}
              </div>
              <span class="font-mono text-[10px] text-ink-muted">Condition A</span>
            </div>

            <!-- Injected Markdown Body for Technical Report -->
            <div 
              class="prose prose-sm max-w-none font-sans text-ink leading-relaxed prose-headings:font-display prose-headings:text-forest prose-headings:font-semibold prose-headings:text-sm prose-p:text-xs prose-p:leading-normal prose-li:text-xs prose-strong:text-ink"
              set:html={technicalReportHtml}
            />

            <!-- External Verification Notice -->
            <div class="border-t border-blueprint pt-4 font-mono text-[11px] space-y-1 text-ink-muted">
              <div class="text-forest font-semibold">✓ Empirical Telemetry & Audit</div>
              <p class="text-[10px] leading-relaxed">
                Empirical dataset based on two-year monitoring campaign across Po Valley residential blocks.
              </p>
            </div>
          </div>
        ) : (
          <div class="border border-blueprint bg-canvas-card p-6 space-y-3">
            <span class="font-mono text-xs text-ink-muted uppercase">Companion Brief</span>
            <p class="text-xs text-ink leading-relaxed">
              Technical companion dossier is currently in review.
            </p>
          </div>
        )}

        <!-- Quick link to Hypothesis / Test info -->
        <div class="border border-blueprint bg-canvas-card p-4 font-sans text-xs flex justify-between items-center">
          <span class="font-mono text-[10px] uppercase text-ink-muted">Parallel Reader Test</span>
          <a href="/the-hypothesis" class="font-mono text-xs font-semibold text-forest hover:underline">
            About the Method →
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- Mobile View Toggle Script -->
  <script is:inline>
    const storyBtn = document.getElementById('mobile-view-story-btn');
    const reportBtn = document.getElementById('mobile-view-report-btn');
    const fictionCol = document.getElementById('fiction-column');
    const techPanel = document.getElementById('technical-panel');

    if (storyBtn && reportBtn && fictionCol && techPanel) {
      storyBtn.addEventListener('click', () => {
        // Show fiction, hide report on mobile
        fictionCol.classList.remove('hidden');
        techPanel.classList.add('hidden');
        techPanel.classList.remove('block');
        
        storyBtn.classList.add('bg-forest', 'text-canvas', 'border-forest');
        storyBtn.classList.remove('bg-canvas', 'text-ink', 'border-blueprint');
        
        reportBtn.classList.remove('bg-forest', 'text-canvas', 'border-forest');
        reportBtn.classList.add('bg-canvas', 'text-ink', 'border-blueprint');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      reportBtn.addEventListener('click', () => {
        // Show report, hide fiction on mobile
        fictionCol.classList.add('hidden');
        techPanel.classList.remove('hidden');
        techPanel.classList.add('block');
        
        reportBtn.classList.add('bg-forest', 'text-canvas', 'border-forest');
        reportBtn.classList.remove('bg-canvas', 'text-ink', 'border-blueprint');
        
        storyBtn.classList.remove('bg-forest', 'text-canvas', 'border-forest');
        storyBtn.classList.add('bg-canvas', 'text-ink', 'border-blueprint');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }
  </script>

  <!-- Citation Dialog (Modal) -->
  <dialog id="citation-dialog" class="backdrop:bg-ink/50 p-6 bg-canvas border border-blueprint max-w-lg w-full text-ink">
    <div class="space-y-4">
      <div class="flex justify-between items-center border-b border-blueprint pb-2">
        <h3 class="font-display text-lg font-semibold text-forest">Cite this Work</h3>
        <button onclick="document.getElementById('citation-dialog').close()" class="font-mono text-xs hover:text-forest">
          ✕ CLOSE
        </button>
      </div>
      <div class="space-y-3 font-mono text-xs">
        <div>
          <span class="text-ink-muted block uppercase text-[10px]">APA Style:</span>
          <p class="bg-canvas-card p-3 border border-blueprint mt-1 select-all">
            {story.data.author} ({new Date(story.data.publishDate).getFullYear()}). {story.data.title}. <em>The Green Screen</em>, 1(1).
          </p>
        </div>
        <div>
          <span class="text-ink-muted block uppercase text-[10px]">BibTeX:</span>
          <pre class="bg-canvas-card p-3 border border-blueprint mt-1 text-[10px] overflow-x-auto select-all">
@article{'{'}thegreenscreen_{story.slug},
  author = "{story.data.author}",
  title = "{story.data.title}",
  journal = "The Green Screen",
  year = "{new Date(story.data.publishDate).getFullYear()}",
  volume = "1",
  number = "1"
{'}'}</pre>
        </div>
      </div>
    </div>
  </dialog>
</Layout>
