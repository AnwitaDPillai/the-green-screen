---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPublishedEntries } from '../../lib/publication';

const allStories = await getCollection('archive');
const published  = getPublishedEntries(allStories);
const skeletons  = [1, 2, 3, 4];
---

<Layout
  title="The Archive — The Green Screen"
  description="Short stories, essays, and poetry about buildings and the people who inhabit them."
>
  <div class="max-w-7xl mx-auto px-6 py-10">

    <div class="border-b-2 border-ink pb-6 mb-8">
      <p class="font-mono text-[9px] uppercase tracking-widest text-rust mb-1">Part 01 — The Literary Magazine</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-ink">The Archive</h1>
      <p class="font-display italic text-lg text-ink-60 mt-2 max-w-2xl">
        An open-submission platform for writing about how the places we live in shape us — and how we might reshape them.
      </p>
    </div>

    <div class="border-b border-ink-12 pb-4 mb-8 flex items-center justify-between font-mono text-[9px] uppercase tracking-widest">
      <div class="flex items-center gap-2 text-ink-60">
        <span>Genre:</span>
        <span class="px-2.5 py-1 bg-ink text-canvas font-ui">All</span>
        <span class="px-2.5 py-1 border border-ink-12 text-ink-60 font-ui">Fiction</span>
        <span class="px-2.5 py-1 border border-ink-12 text-ink-60 font-ui">Essay</span>
        <span class="px-2.5 py-1 border border-ink-12 text-ink-60 font-ui">Poetry</span>
      </div>
      <span class="text-ink-60">{published.length} published piece{published.length !== 1 ? 's' : ''}</span>
    </div>

    {published.length > 0 ? (
      <div class="divide-y divide-ink-12">
        {published.map((story) => (
          <article class="py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 hover:bg-forest-10 transition-colors px-2">
            <div class="lg:col-span-2 font-mono text-[9px] uppercase tracking-wider text-ink-60 space-y-1.5">
              <p class="text-rust font-medium">{story.data.genre}</p>
              <p>{story.data.readingTimeMinutes} min</p>
              <p>{story.data.buildingTypology}</p>
              <p>Issue {story.data.issueNumber}</p>
            </div>
            <div class="lg:col-span-7 space-y-3">
              <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink leading-snug">
                <a href={`/archive/${story.slug}`} class="hover:text-forest transition-colors">{story.data.title}</a>
              </h2>
              {story.data.subtitle && (
                <p class="font-display italic text-base text-ink-60">{story.data.subtitle}</p>
              )}
              <p class="font-ui text-[12px] text-ink-60">By <span class="text-ink font-medium">{story.data.author}</span></p>
            </div>
            <div class="lg:col-span-3 border-l border-ink-12 pl-6 space-y-2">
              <p class="font-mono text-[9px] uppercase tracking-widest text-ink-60">Paired Building</p>
              <p class="font-ui text-[12px] font-semibold text-ink">{story.data.pairedBuildingName}</p>
              <p class="font-ui text-[11px] text-ink-60">{story.data.pairedBuildingLocation}</p>
              <p class="font-display italic text-[11px] text-forest leading-snug">{story.data.pairedIntervention}</p>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="divide-y divide-ink-12">
        {skeletons.map((_n) => (
          <div class="py-8 grid grid-cols-1 lg:grid-cols-12 gap-6 px-2">
            <div class="lg:col-span-2 space-y-2">
              <div class="skeleton h-2.5 w-12 rounded"></div>
              <div class="skeleton h-2.5 w-16 rounded"></div>
            </div>
            <div class="lg:col-span-7 space-y-3">
              <div class="skeleton h-7 w-full rounded"></div>
              <div class="skeleton h-7 w-3/4 rounded"></div>
              <div class="skeleton h-4 w-40 rounded"></div>
            </div>
            <div class="lg:col-span-3 border-l border-ink-12 pl-6 space-y-2">
              <div class="skeleton h-2.5 w-20 rounded"></div>
              <div class="skeleton h-4 w-full rounded"></div>
              <div class="skeleton h-3 w-3/4 rounded"></div>
            </div>
          </div>
        ))}
        <div class="py-10 text-center font-ui text-[12px] text-ink-60 italic">
          The first issue of The Green Screen is forthcoming. Submissions are open.
        </div>
      </div>
    )}

  </div>
</Layout>
