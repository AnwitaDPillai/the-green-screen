---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Submissions & Intake — The Green Screen"
  description="Open submissions for stories, essays, and poetry exploring the built environment and green retrofit."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-12">
    <header class="border-b border-blueprint pb-8 space-y-3">
      <div class="font-mono text-xs uppercase tracking-widest text-terracotta font-semibold">
        CONTRIBUTOR PORTAL // INTAKE PROTOCOL
      </div>
      <h1 class="font-display text-4xl sm:text-5xl text-forest font-semibold">
        Submit to The Green Screen
      </h1>
      <p class="font-serif italic text-lg text-ink-light">
        We welcome short stories, literary essays, and poetry about buildings and the people who live within them.
      </p>
    </header>

    <!-- Submissions Protocol Steps -->
    <div class="space-y-8 font-sans text-xs">
      <div class="border border-blueprint bg-canvas-paper p-6 space-y-3">
        <span class="font-mono text-[10px] uppercase text-forest font-semibold tracking-wider">
          THE PAIRING PRINCIPLE
        </span>
        <h3 class="font-display text-xl text-ink font-semibold">How Each Piece is Structured</h3>
        <p class="font-serif text-sm text-ink-light leading-relaxed">
          Every submission must explore a specific typology of the built environment—cinemas, libraries, municipal housing, primary schools, or post-war civic halls. You do not need to be an engineer; our editorial team and technical advisors will collaborate with you to pair your story with an authentic, documented retrofit intervention.
        </p>
      </div>

      <!-- Confidential Intake Notice -->
      <div class="border border-terracotta/40 bg-canvas-card p-6 space-y-3">
        <span class="font-mono text-[10px] uppercase text-terracotta font-semibold tracking-wider block">
          EDITORIAL INTEGRITY & PRIVACY PROTOCOL
        </span>
        <h4 class="font-display text-base text-ink font-semibold">Private Intake Channel</h4>
        <p class="font-serif text-xs text-ink-muted leading-relaxed">
          In accordance with our publication security policy, unpublished drafts, private author contact information, and rejection/revision logs are never kept in the public website repository. Submissions are reviewed privately by our editorial board.
        </p>
        <div class="pt-2">
          <p class="font-mono text-xs text-forest font-medium">
            Send manuscript queries directly to: <span class="underline">submissions@thegreenscreen.org</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
